# ─── APP ───────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://yourdomain.com
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_RANDOM_STRING

# ─── SUPABASE ──────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

# ─── ORACLE OBJECT STORAGE ─────────────────────────────
ORACLE_NAMESPACE=your_namespace
ORACLE_BUCKET_NAME=imperialseal-files
ORACLE_REGION=us-ashburn-1
ORACLE_ACCESS_KEY_ID=your_access_key
ORACLE_SECRET_ACCESS_KEY=your_secret_key
ORACLE_ENDPOINT=https://your_namespace.compat.objectstorage.us-ashburn-1.oraclecloud.com

# ─── BLOCKCHAIN — VOI ──────────────────────────────────
VOI_NODE_URL=https://mainnet-api.voi.nodly.io
VOI_INDEXER_URL=https://mainnet-idx.voi.nodly.io
VOI_NODE_TOKEN=

# ─── BLOCKCHAIN — ALGORAND ─────────────────────────────
ALGO_NODE_URL=https://mainnet-api.algonode.cloud
ALGO_INDEXER_URL=https://mainnet-idx.algonode.cloud
ALGO_NODE_TOKEN=

# ─── COINGECKO ─────────────────────────────────────────
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# ─── EMAIL — DEFAULT SENDGRID ──────────────────────────
SENDGRID_API_KEY=SG.xxxxx
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
DEFAULT_FROM_NAME=ImperialSeal

# ─── SUPER ADMIN ───────────────────────────────────────
SUPER_ADMIN_EMAIL=irfan@imperialseal.io
SUPER_ADMIN_PASSWORD_HASH=GENERATE_WITH_BCRYPT

# ─── PLATFORM DEFAULTS ─────────────────────────────────
BRAND_NAME=ImperialSeal
PUBLIC_VERIFICATION_BASE_URL=https://yourdomain.com/verify